{
  "name": "gatsby-source-strava",
  "version": "4.1.0",
  "description": "Gatsby plugin to use Strava as a data source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/gatsby-source-strava.git"
  },
  "author": "Cédric Delpoux",
  "license": "MIT",
  "private": false,
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source",
    "strava"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "gatsby-node.js",
    "utils",
    "docs"
  ],
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "chokidar": "^3.5.3",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "inquirer": "^8.2.0",
    "json-bigint": "^1.0.0",
    "open": "^8.4.0",
    "strava-v3": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependencies": {
    "gatsby": ">=3.0.0"
  },
  "scripts": {
    "lint": "eslint *.js gatsby-node.js utils example/src",
    "prepublishOnly": "yarn lint",
    "prepare": "husky"
  },
  "bin": {
    "gatsby-source-strava-activity": "utils/fetch-activity.js",
    "gatsby-source-strava-token": "utils/generate-token.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint"
    ],
    "*.{css,js,md}": [
      "prettier --write"
    ]
  }
}
