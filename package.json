{
  "name": "gatsby-source-strava",
  "version": "3.1.0",
  "description": "Gatsby plugin to use Strava as a data source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/gatsby-source-strava.git"
  },
  "author": "Cédric Delpoux",
  "license": "MIT",
  "private": false,
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source",
    "strava"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "gatsby-node.js",
    "utils",
    "docs"
  ],
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "inquirer": "^8.2.0",
    "open": "^8.4.0",
    "strava-v3": "^4.0.1"
  },
  "devDependencies": {
    "eslint": "^8.2.0",
    "eslint-config-prettier": "^8.3.0",
    "husky": "^4.3.0",
    "lint-staged": "^11.2.6",
    "prettier": "3.9.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependencies": {
    "gatsby": ">=3.0.0"
  },
  "scripts": {
    "lint": "eslint *.js gatsby-node.js utils example/src",
    "prepublishOnly": "yarn lint"
  },
  "bin": {
    "gatsby-source-strava-activity": "utils/fetch-activity.js",
    "gatsby-source-strava-token": "utils/generate-token.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint"
    ],
    "*.{css,js,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
